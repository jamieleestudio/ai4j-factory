[
  {
    "name": "订单分析",
    "table": "orders",
    "description": "所有订单数据，一条记录是一个订单",
    "metrics": [
      {
        "name": "销售额",
        "column": "amount",
        "aggregation": "SUM",
        "description": "订单金额总和"
      },
      {
        "name": "订单量",
        "column": "id",
        "aggregation": "COUNT",
        "description": "订单总数"
      },
      {
        "name": "平均客单价",
        "column": "amount",
        "aggregation": "AVG",
        "description": "每笔订单平均金额"
      }
    ],
    "dimensions": [
      {
        "name": "区域",
        "column": "region",
        "type": "STRING"
      },
      {
        "name": "产品线",
        "column": "product_line",
        "type": "STRING"
      },
      {
        "name": "签单人",
        "column": "signed_by",
        "type": "STRING"
      },
      {
        "name": "下单时间",
        "column": "created_at",
        "type": "TIME"
      }
    ]
  }
]
